<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gen Z Bank - Demo</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Arial,Helvetica,sans-serif}
body{background:#f4f5f9;color:#171717}
button{cursor:pointer}
.hidden{display:none!important}
.logo{text-align:center;font-size:30px;font-weight:900;letter-spacing:-1px;margin-bottom:10px}
.logo span{color:#7c3aed}
.auth-container{min-height:100vh;display:flex;justify-content:center;align-items:center;padding:20px}
.auth-box{width:100%;max-width:430px;background:white;padding:30px;border-radius:24px;box-shadow:0 15px 50px rgba(0,0,0,.08)}
.demo-label{text-align:center;color:#7c3aed;font-size:12px;font-weight:bold;margin-bottom:20px}
.auth-box h2{text-align:center;margin-bottom:25px}
input,select{width:100%;padding:15px;border:1px solid #ddd;border-radius:12px;margin-bottom:14px;font-size:15px;outline:none}
input:focus,select:focus{border-color:#7c3aed}
.primary-btn{width:100%;border:none;padding:15px;border-radius:12px;background:#7c3aed;color:white;font-weight:bold;font-size:15px}
.secondary-btn{width:100%;border:none;padding:14px;border-radius:12px;background:#111827;color:white;font-weight:bold;margin-top:10px}
.switch-text{text-align:center;margin-top:20px;font-size:14px}
.switch-text button{background:none;border:none;color:#7c3aed;font-weight:bold}
.app{min-height:100vh}
.topbar{background:white;padding:18px 6%;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #eee}
.topbar .logo{margin:0;font-size:22px}
.logout{background:#fee2e2;color:#dc2626;border:none;padding:10px 15px;border-radius:10px;font-weight:bold}
.container{max-width:1100px;margin:auto;padding:25px 20px 100px}
.welcome{margin-bottom:20px}
.balance-card{background:linear-gradient(135deg,#7c3aed,#ec4899);color:white;border-radius:25px;padding:30px;margin-bottom:20px;box-shadow:0 20px 40px rgba(124,58,237,.2)}
.balance-card small{opacity:.85}
.balance{font-size:40px;font-weight:900;margin:10px 0}
.actions{display:grid;grid-template-columns:repeat(2,1fr);gap:15px;margin-bottom:25px}
.action-btn{background:white;border:none;padding:20px;border-radius:18px;font-weight:bold;box-shadow:0 5px 20px rgba(0,0,0,.05)}
.support{background:#111827;color:white;padding:20px;border-radius:18px;margin-bottom:25px}
.whatsapp{display:inline-block;margin-top:12px;background:#25D366;color:white;text-decoration:none;padding:12px 18px;border-radius:10px;font-weight:bold}
.history{background:white;padding:25px;border-radius:20px}
.history h3{margin-bottom:15px}
.transaction{display:flex;justify-content:space-between;align-items:center;padding:15px 0;border-bottom:1px solid #eee}
.credit{color:#16a34a;font-weight:bold}.debit{color:#dc2626;font-weight:bold}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.6);display:flex;justify-content:center;align-items:center;padding:20px;z-index:100}
.modal-box{background:white;width:100%;max-width:450px;border-radius:22px;padding:28px;max-height:90vh;overflow:auto}
.modal-box h2{margin-bottom:15px}.modal-box p{line-height:1.6;color:#555;margin-bottom:18px}
.close-btn{background:#eee;color:#111;border:none;width:100%;padding:14px;border-radius:10px;margin-top:10px;font-weight:bold}
.receipt{background:#fafafa;border:1px dashed #bbb;padding:20px;border-radius:15px;margin:15px 0}
.receipt div{display:flex;justify-content:space-between;padding:7px 0}
.success{text-align:center;font-size:20px;color:#16a34a;font-weight:bold;margin-bottom:15px}
.upgrade-card{background:#fff7ed;border:1px solid #ff9800;padding:18px;border-radius:15px;margin-bottom:15px}
@media(max-width:600px){.balance{font-size:32px}}
</style>
</head>
<body>

<section id="signupPage" class="auth-container">
<div class="auth-box">
<div class="logo">GEN<span>Z</span> BANK</div>
<div class="demo-label">DEMO BANKING APPLICATION</div>
<h2>Create Account</h2>
<input id="fullName" placeholder="FULL NAME">
<input id="phone" placeholder="PHONE NUMBER">
<input id="email" placeholder="EMAIL ADDRESS">
<input id="signupPin" type="password" maxlength="6" inputmode="numeric" placeholder="6 DIGIT PIN">
<input id="transferPin" type="password" maxlength="4" inputmode="numeric" placeholder="4 DIGIT TRANSFER PIN">
<button class="primary-btn" onclick="signup()">CREATE ACCOUNT</button>
<div class="switch-text">Already have an account? <button onclick="showLogin()">Login</button></div>
</div></section>

<section id="loginPage" class="auth-container hidden">
<div class="auth-box">
<div class="logo">GEN<span>Z</span> BANK</div>
<div class="demo-label">DEMO BANKING APPLICATION</div>
<h2>Welcome Back</h2>
<input id="loginIdentity" placeholder="PHONE NUMBER OR EMAIL">
<input id="loginPin" type="password" maxlength="6" inputmode="numeric" placeholder="6 DIGIT PIN">
<button class="primary-btn" onclick="login()">LOGIN</button>
<div class="switch-text">Don't have an account? <button onclick="showSignup()">Sign Up</button></div>
</div></section>

<section id="appPage" class="app hidden">
<header class="topbar"><div class="logo">GEN<span>Z</span> BANK</div><button class="logout" onclick="logout()">Logout</button></header>
<div class="container">
<div class="welcome"><h2 id="userGreeting">Welcome</h2><p>Your Gen Z Bank demo dashboard</p><div id="premiumBadge"></div></div>
<div class="balance-card"><small>AVAILABLE BALANCE</small><div class="balance">₦<span id="balance">0.00</span></div><small id="accountNameDisplay"></small></div>
<div class="actions">
<button class="action-btn" onclick="openTransfer()">💸<br>Transfer</button>
<button class="action-btn" onclick="openDeposit()">💰<br>Deposit</button>
<button class="action-btn" onclick="showHistory()">📜<br>History</button>
<button class="action-btn" onclick="openSupport()">💬<br>Support</button>
</div>
<div class="support"><h3>Need Help?</h3><p>Chat with support.</p><a class="whatsapp" href="https://wa.me/2348036233499" target="_blank">WhatsApp: 08036233499</a></div>
<div class="history"><h3>Recent Transactions</h3><div id="transactionList"><p>No transactions yet.</p></div></div>
</div></section>

<div id="bonusModal" class="modal hidden"><div class="modal-box"><h2>Welcome Bonus</h2><p>You have been credited with <strong>₦75,000</strong> demo bonus.</p><button class="primary-btn" onclick="acceptBonus()">Accept</button></div></div>
<div id="transferModal" class="modal hidden"><div class="modal-box"><h2>Transfer</h2><input id="accountNumber" maxlength="10" inputmode="numeric" placeholder="ACCOUNT NUMBER" oninput="lookupAccount()"><select id="bankSelect"><option value="">SELECT BANK</option></select><div id="accountVerification" style="background:#f4f4f4;padding:12px;border-radius:10px;margin-bottom:15px;">Enter account number.</div><button class="primary-btn" onclick="proceedTransfer()">PROCEED</button><button class="close-btn" onclick="closeTransfer()">CANCEL</button></div></div>
<div id="detailsModal" class="modal hidden"><div class="modal-box"><h2>Transfer Details</h2><div id="recipientDetails"></div><input id="amount" type="number" placeholder="AMOUNT"><input id="narration" placeholder="NARRATION"><button class="primary-btn" onclick="confirmTransfer()">SEND</button><button class="close-btn" onclick="closeDetails()">CANCEL</button></div></div>
<div id="pinModal" class="modal hidden"><div class="modal-box"><h2>Confirm</h2><div id="finalRecipient" style="background:#f4f4f4;padding:15px;border-radius:10px;margin-bottom:15px;"></div><input id="confirmTransferPin" type="password" maxlength="4" placeholder="4 DIGIT TRANSFER PIN"><button class="primary-btn" onclick="sendMoney()">CONFIRM & SEND</button><button class="close-btn" onclick="closePin()">CANCEL</button></div></div>
<div id="receiptModal" class="modal hidden"><div class="modal-box"><div class="success">✓ Sent Successfully</div><div id="receiptContent" class="receipt"></div><button class="primary-btn" onclick="printReceipt()">PRINT RECEIPT</button><button class="close-btn" onclick="closeReceipt()">CLOSE</button></div></div>

<div id="depositModal" class="modal hidden"><div class="modal-box">
<div class="upgrade-card">
<h2>⭐ Upgrade Account - ₦5,000</h2>
<p>• Auto add balance<br>• Deposit any amount of your choice<br>• Allow screenshots<br>• Full receipt view</p>
<div style="background:#000;color:#ff9800;text-align:center;padding:12px;border-radius:10px;margin:12px 0;font-size:22px;font-weight:900">₦5,000 <div style="font-size:12px;color:#888;font-weight:normal">One-time payment</div></div>
<p style="text-align:center">Message <b>08036233499</b> to pay and get your code.</p>
<button class="primary-btn" style="background:#ff9800;color:#000" onclick="document.getElementById('upgradeBox').classList.remove('hidden')">UPGRADE NOW</button>
<div id="upStatus" style="margin-top:10px"></div>
</div>
<div id="upgradeBox" class="hidden" style="background:#f4f4f4;padding:15px;border-radius:12px;margin-bottom:12px">
<b>Enter Upgrade Code</b>
<input id="upCode" placeholder="Paste code here" style="margin-top:10px">
<button class="primary-btn" style="background:#ff9800;color:#000" onclick="verifyUpgrade()">ACTIVATE</button>
</div>
<div id="premiumBox" class="hidden" style="background:#ecfdf5;border:1px solid #16a34a;padding:15px;border-radius:12px;margin-bottom:12px">
<b>💎 Premium Active</b>
<p style="font-size:13px;margin:8px 0">Add any amount instantly:</p>
<input id="customAmt" type="number" placeholder="Enter amount">
<button class="primary-btn" style="background:#16a34a" onclick="addCustom()">ADD BALANCE</button>
<button class="secondary-btn" onclick="autoAdd()">⚡ AUTO ADD ₦50,000</button>
</div>
<button class="close-btn" onclick="closeDeposit()">CLOSE</button>
</div></div>

<script>
const banks=["Access Bank","Citibank Nigeria","Ecobank Nigeria","Fidelity Bank","First Bank","FCMB","Globus Bank","GTBank","Jaiz Bank","Keystone Bank","Moniepoint","Opay","Palmpay","Polaris Bank","Stanbic IBTC","Sterling Bank","UBA","Union Bank","Wema Bank","Zenith Bank"];
const bankSelect=document.getElementById("bankSelect");
banks.forEach(b=>{let o=document.createElement("option");o.value=b;o.textContent=b;bankSelect.appendChild(o)});

let currentUser=null,transferData={};
// Hidden verification - real code NOT in file
const _h=2300150719;
function _x(s){let h=5381;for(let i=0;i<s.length;i++){h=(((h<<5)+h+s.charCodeAt(i))>>>0)}return h}
function isPremium(){return localStorage.getItem('genz_premium')==='1'}

function signup(){
let name=document.getElementById("fullName").value.trim(),phone=document.getElementById("phone").value.trim(),email=document.getElementById("email").value.trim(),pin=document.getElementById("signupPin").value,tp=document.getElementById("transferPin").value;
if(!name||!phone||!email||pin.length!==6||tp.length!==4){alert("Complete all fields correctly.");return}
localStorage.setItem("genZUser",JSON.stringify({name,phone,email,pin,transferPin:tp,balance:0,bonusAccepted:false,lastDailyCredit:null,transactions:[]}));
alert("Account created. Please login.");showLogin();
}
function login(){
let id=document.getElementById("loginIdentity").value.trim(),pin=document.getElementById("loginPin").value;
let s=localStorage.getItem("genZUser");if(!s){alert("No account found.");return}
let u=JSON.parse(s);
if((id!==u.phone&&id.toLowerCase()!==u.email.toLowerCase())||pin!==u.pin){alert("Invalid login.");return}
currentUser=u;showApp();
}
function showApp(){
document.getElementById("signupPage").classList.add("hidden");
document.getElementById("loginPage").classList.add("hidden");
document.getElementById("appPage").classList.remove("hidden");
document.getElementById("userGreeting").textContent="Hello, "+currentUser.name;
document.getElementById("accountNameDisplay").textContent=currentUser.name;
if(isPremium())document.getElementById("premiumBadge").innerHTML='<span style="background:#16a34a;color:white;padding:5px 12px;border-radius:20px;font-size:12px">💎 PREMIUM</span>';
updateBalance();renderTransactions();
if(!currentUser.bonusAccepted)setTimeout(()=>document.getElementById("bonusModal").classList.remove("hidden"),500);
processDailyReward();
}
function acceptBonus(){if(!currentUser.bonusAccepted){currentUser.balance+=75000;currentUser.bonusAccepted=true;addTransaction("Welcome Bonus",75000,"Bonus")}saveUser();updateBalance();document.getElementById("bonusModal").classList.add("hidden")}
function processDailyReward(){let t=new Date().toISOString().slice(0,10);if(currentUser.lastDailyCredit!==t){currentUser.balance+=1000;currentUser.lastDailyCredit=t;addTransaction("Daily Reward",1000,"Daily");saveUser();updateBalance();renderTransactions()}}
function addTransaction(d,a,n){currentUser.transactions.unshift({description:d,amount:a,narration:n,date:new Date().toLocaleString()})}
function renderTransactions(){let l=document.getElementById("transactionList");if(!currentUser.transactions.length){l.innerHTML="<p>No transactions yet.</p>";return}l.innerHTML=currentUser.transactions.map(tx=>`<div class="transaction"><div><strong>${tx.description}</strong><br><small>${tx.date}</small></div><span class="${tx.amount>=0?'credit':'debit'}">${tx.amount>=0?'+':'-'} ₦${Math.abs(tx.amount).toLocaleString()}</span></div>`).join("")}
function updateBalance(){document.getElementById("balance").textContent=currentUser.balance.toLocaleString(undefined,{minimumFractionDigits:2})}
function saveUser(){localStorage.setItem("genZUser",JSON.stringify(currentUser))}
function openTransfer(){document.getElementById("transferModal").classList.remove("hidden")}
function closeTransfer(){document.getElementById("transferModal").classList.add("hidden")}
function lookupAccount(){let a=document.getElementById("accountNumber").value,b=document.getElementById("accountVerification"),bank=bankSelect.value;if(a.length!==10){b.textContent="Enter 10-digit account.";return}if(!bank){b.textContent="Select bank.";return}b.innerHTML=`<strong>DEMO CONFIRMATION</strong><br>Acct: ${a}<br>Bank: ${bank}<br>Name: Demo Recipient`}
function proceedTransfer(){let a=document.getElementById("accountNumber").value,b=bankSelect.value;if(a.length!==10||!b){alert("Enter valid details.");return}transferData={account:a,bank:b,accountName:"Demo Recipient"};closeTransfer();document.getElementById("recipientDetails").innerHTML=`<div style="background:#f4f4f4;padding:15px;border-radius:10px;margin-bottom:15px"><b>${transferData.accountName}</b><br>${transferData.account}<br>${transferData.bank}</div>`;document.getElementById("detailsModal").classList.remove("hidden")}
function closeDetails(){document.getElementById("detailsModal").classList.add("hidden")}
function confirmTransfer(){let amt=Number(document.getElementById("amount").value);if(!amt||amt<=0){alert("Enter amount.");return}if(amt>currentUser.balance){alert("Insufficient balance.");return}transferData.amount=amt;transferData.narration=document.getElementById("narration").value||"Transfer";closeDetails();document.getElementById("finalRecipient").innerHTML=`<b>CONFIRM</b><br><br>${transferData.accountName}<br>${transferData.account}<br>${transferData.bank}<br><br>₦${amt.toLocaleString()}`;document.getElementById("pinModal").classList.remove("hidden")}
function closePin(){document.getElementById("pinModal").classList.add("hidden")}
function sendMoney(){let p=document.getElementById("confirmTransferPin").value;if(p!==currentUser.transferPin){alert("Wrong PIN.");return}currentUser.balance-=transferData.amount;addTransaction("Transfer to "+transferData.accountName,-transferData.amount,transferData.narration);saveUser();updateBalance();renderTransactions();closePin();
let prem=isPremium();
let full=`<div><strong>Status</strong><span>Successful</span></div><div><strong>Recipient</strong><span>${transferData.accountName}</span></div><div><strong>Account</strong><span>${transferData.account}</span></div><div><strong>Bank</strong><span>${transferData.bank}</span></div><div><strong>Amount</strong><span>₦${transferData.amount.toLocaleString()}</span></div><div><strong>Narration</strong><span>${transferData.narration}</span></div><div><strong>Date</strong><span>${new Date().toLocaleString()}</span></div><div><strong>Ref</strong><span>GZ${Date.now()}</span></div>`;
let limited=`<div><strong>Status</strong><span>Successful</span></div><div><strong>Amount</strong><span>₦${transferData.amount.toLocaleString()}</span></div><p style="text-align:center;color:#888;margin-top:10px">Upgrade to Premium to see full receipt</p>`;
document.getElementById("receiptContent").innerHTML=prem?full:limited;
document.getElementById("receiptModal").classList.remove("hidden")}
function printReceipt(){let c=document.getElementById("receiptContent").innerHTML,w=window.open("","","width=500,height=700");w.document.write(`<html><head><title>Receipt</title><style>body{font-family:Arial;padding:30px}.receipt div{display:flex;justify-content:space-between;padding:8px 0}</style></head><body><h2 style="text-align:center">GEN Z BANK</h2><div class="receipt">${c}</div><p style="text-align:center">DEMO ONLY</p></body></html>`);w.document.close();w.print()}
function closeReceipt(){document.getElementById("receiptModal").classList.add("hidden")}
function openDeposit(){document.getElementById("depositModal").classList.remove("hidden");checkPremiumUI()}
function closeDeposit(){document.getElementById("depositModal").classList.add("hidden")}
function checkPremiumUI(){if(isPremium()){document.getElementById("premiumBox").classList.remove("hidden");document.getElementById("upStatus").innerHTML='<span style="color:#16a34a">✓ Premium Active</span>'}}
function verifyUpgrade(){let c=document.getElementById("upCode").value.trim();if(_x(c)===_h){localStorage.setItem('genz_premium','1');alert("Upgrade successful!");checkPremiumUI();showApp()}else{alert("Invalid code. Contact 08036233499 after payment.")}}
function addCustom(){if(!isPremium())return alert("Upgrade required");let a=Number(document.getElementById("customAmt").value);if(!a||a<=0)return alert("Enter amount");currentUser.balance+=a;addTransaction("Premium Deposit",a,"Custom deposit");saveUser();updateBalance();renderTransactions();alert("₦"+a.toLocaleString()+" added")}
function autoAdd(){if(!isPremium())return;currentUser.balance+=50000;addTransaction("Auto Credit",50000,"Auto");saveUser();updateBalance();renderTransactions();alert("₦50,000 auto-added")}
function openSupport(){window.open("https://wa.me/2348036233499","_blank")}
function showHistory(){document.querySelector(".history").scrollIntoView({behavior:"smooth"})}
function showLogin(){document.getElementById("signupPage").classList.add("hidden");document.getElementById("loginPage").classList.remove("hidden")}
function showSignup(){document.getElementById("loginPage").classList.add("hidden");document.getElementById("signupPage").classList.remove("hidden")}
function logout(){currentUser=null;document.getElementById("appPage").classList.add("hidden");showLogin()}
// Block screenshots for non-premium
document.addEventListener('keyup',e=>{if(e.key==='PrintScreen'&&!isPremium()){alert('Screenshots disabled. Upgrade to Premium to allow.')}});
document.addEventListener('contextmenu',e=>{if(!isPremium())e.preventDefault()});
window.onload=()=>{if(localStorage.getItem("genZUser"))showLogin()};
</script>
</body>
</html>
